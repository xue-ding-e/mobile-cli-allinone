{
  "name": "@xue-ding-e/mobile-mcp-allinone",
  "mcpName": "io.github.xue-ding-e/mobile-mcp-allinone",
  "version": "0.0.1",
  "description": "Multi-platform mobile CLI and MCP for Android, HarmonyOS and iOS, with Android WebView CDP and JSON flow replay",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xue-ding-e/mobile-cli-allinone.git"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "node scripts/build.cjs",
    "lint": "eslint .",
    "fixlint": "eslint . --fix",
    "test": "c8 playwright test",
    "watch": "tsc --watch",
    "clean": "rm -rf lib",
    "prepare": "husky",
    "test:offline": "npm run build && playwright test test/png.ts test/harmony.test.ts test/android-install.test.ts test/cli-ios.test.ts test/wda-errors.test.ts test/server-platform-routing.test.ts test/ios-cli-local-offline.test.ts test/ios-cli-wda-integration-local.test.ts test/wda-local-offline.test.ts test/ios-identity-offline.test.ts test/ios-wifi-install-offline.test.ts test/simulator-screenshot-offline.test.ts test/simulator-wda-binding-offline.test.ts"
  },
  "files": [
    "lib",
    "scripts/ios-wifi-bridge/device.py",
    "scripts/ios-wifi-bridge/identity_probe.py",
    "scripts/ios-wifi-bridge/install_wifi.py",
    "scripts/ios-wifi-bridge/requirements.txt",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "@types/ws": "^8.18.1",
    "ajv": "^8.18.0",
    "commander": "14.0.0",
    "express": "5.1.0",
    "fast-xml-parser": "5.8.0",
    "mobilewright": "0.0.45",
    "qs": "^6.15.0",
    "ws": "^8.21.0",
    "zod": "^4.1.13",
    "zod-to-json-schema": "3.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.49.0",
    "@stylistic/eslint-plugin": "^3.0.1",
    "@types/commander": "^2.12.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.26.1",
    "@typescript-eslint/utils": "^8.26.1",
    "c8": "^10.1.3",
    "eslint": "^9.19.0",
    "eslint-plugin": "^1.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-notice": "^1.0.0",
    "husky": "^9.1.7",
    "typescript": "5.8.2"
  },
  "main": "index.js",
  "bin": {
    "mcp-server-mobile": "lib/index.js",
    "mobile-cli-allinone": "lib/cli.js"
  },
  "directories": {
    "lib": "lib"
  },
  "author": "xue-ding-e",
  "bugs": {
    "url": "https://github.com/xue-ding-e/mobile-cli-allinone/issues"
  },
  "homepage": "https://github.com/xue-ding-e/mobile-cli-allinone#readme"
}
